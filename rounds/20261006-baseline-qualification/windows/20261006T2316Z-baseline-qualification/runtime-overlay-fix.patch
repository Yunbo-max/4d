+             patch.object(native_runtime.sys, 'path', [str(self.venv_site), str(self.base_site)]), \
+             patch.object(native_runtime.sys, 'prefix', str(self.venv_prefix)), \
+             patch.object(native_runtime.sys, 'base_prefix', str(self.prefix)):
